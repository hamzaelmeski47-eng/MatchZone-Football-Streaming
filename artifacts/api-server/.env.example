# MySQL 8+ connection string. Do not commit a real password.
DATABASE_URL=mysql://username:password@localhost:3306/matchzone

# Use a random value with at least 32 characters. Store the real value in Replit Secrets.
JWT_SECRET=replace-with-a-random-32-character-secret

# The workflow provides PORT automatically; keep this for local runs.
PORT=5000

# API-Football API Key from https://dashboard.api-football.com (v3)
API_FOOTBALL_KEY=your_api_football_key_here
 
# SportSRC V2 Live Stream Provider (Server-only)
LIVE_STREAM_API_KEY=
LIVE_STREAM_PROVIDER_URL=https://api.sportsrc.org/v2/