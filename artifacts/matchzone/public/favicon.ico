<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="mz-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b1118"/>
      <stop offset="100%" stop-color="#141c26"/>
    </linearGradient>
    <linearGradient id="mz-glow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#b7ff4a"/>
      <stop offset="100%" stop-color="#73e600"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#b7ff4a" flood-opacity="0.6"/>
    </filter>
  </defs>
  
  <!-- Rounded App Tile -->
  <rect width="64" height="64" rx="16" fill="url(#mz-bg)"/>
  <rect x="1.5" y="1.5" width="61" height="61" rx="14.5" fill="none" stroke="#b7ff4a" stroke-width="1.5" stroke-opacity="0.25"/>
  
  <!-- Outer MatchZone Diamond Pitch Mark -->
  <g transform="translate(32 32) rotate(-8) translate(-32 -32)" filter="url(#glow)">
    <rect x="14" y="14" width="36" height="36" rx="11" fill="none" stroke="url(#mz-glow)" stroke-width="3.5"/>
    <!-- Pitch Midfield Line -->
    <line x1="14" y1="32" x2="50" y2="32" stroke="url(#mz-glow)" stroke-width="2" stroke-opacity="0.8"/>
    <!-- Center Circle -->
    <circle cx="32" cy="32" r="7.5" fill="none" stroke="url(#mz-glow)" stroke-width="2.5"/>
    <!-- Center Dot / Live Beacon -->
    <circle cx="32" cy="32" r="3.2" fill="url(#mz-glow)"/>
  </g>
</svg>
